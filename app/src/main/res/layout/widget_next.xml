<?xml version="1.0" encoding="utf-8"?>
<!-- The Next event widget (SPEC §17.4): a frame (the surface, radius 24, padding top 28, sides 14, bottom 12) with the badge on its top-start corner, sticking out 8 dp to the start and 10 dp above. Inside: the time pill in the calendar's fill, the title on up to two lines, the place. 2 dp at the end and 4 at the foot leave room for the shadow, which falls downward. Sizes are in dp, text too. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipToOutline="true"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_frame"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="28dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="22dp">

            <ImageView
                android:id="@+id/time_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_time_pill" />

            <!-- As tall as the pill: a frame of unset width measures its children again at its own final size only when
                 two or more of them match it, and only then does the colored shape under the text get the text's width -->
            <TextView
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text=""
                android:textSize="12dp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineHeight="22dp"
            android:maxLines="2"
            android:text=""
            android:textColor="@color/widget_on_surface"
            android:textSize="17dp" />

        <TextView
            android:id="@+id/place"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="12dp" />
    </LinearLayout>

    <include layout="@layout/widget_badge" />
</FrameLayout>
