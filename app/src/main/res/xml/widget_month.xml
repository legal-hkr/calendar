<?xml version="1.0" encoding="utf-8"?>
<!-- Month (SPEC §17.5): four by four cells, resizable in width and in height down to four cells: lower, the days' dots are cut (the owner, 16 Nov 2026). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_month_description"
    android:initialLayout="@layout/widget_month"
    android:minWidth="250dp"
    android:minHeight="250dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="250dp"
    android:previewLayout="@layout/widget_month_preview"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
