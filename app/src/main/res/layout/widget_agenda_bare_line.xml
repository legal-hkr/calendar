<?xml version="1.0" encoding="utf-8"?>
<!-- An event of today in the Agenda without a background (SPEC §17.8), 18 dp high with 6 dp above: an 8 dp dot in the dark theme's calendar color, the time (500) and the title (400), 14 dp, white with the soft shadow. "Nothing planned" uses the title alone. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription"
    android:id="@+id/line"
    android:layout_width="match_parent"
    android:layout_height="24dp"
    android:baselineAligned="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp">

    <!-- The dot over its shadow; the frame is twice the dot's size and gives the line back the half on each side -->
    <FrameLayout
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="-4dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/widget_bare_dot_shadow" />

        <ImageView
            android:id="@+id/dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center"
            android:src="@drawable/widget_dot" />
    </FrameLayout>

    <TextView
        android:id="@+id/time"
        style="@style/WidgetBareText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:fontFamily="sans-serif-medium"
        android:text=""
        android:textSize="14dp" />

    <TextView
        android:id="@+id/title"
        style="@style/WidgetBareText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:text=""
        android:textSize="14dp" />
</LinearLayout>
