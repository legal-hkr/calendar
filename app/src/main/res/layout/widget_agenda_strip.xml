<?xml version="1.0" encoding="utf-8"?>
<!-- An event's strip in the Agenda widget (SPEC §17.2): 56 dp, the surface, radius 18. The time tile (64 × 44, radius 12) in the calendar's fill shows the start over the end, or two lines of words ("all day", "until 06:30"); then the title on two lines, or on one with the place under it. The 6 dp above part it from the piece before. Sizes are in dp, text too. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription,UselessParent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="6dp">

    <LinearLayout
        android:id="@+id/strip"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/widget_strip"
        android:elevation="2dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="14dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/tile_fill"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:src="@drawable/widget_tile" />

            <LinearLayout
                android:id="@+id/tile_times"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tile_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textSize="13.5dp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tile_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textSize="11dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tile_words"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:text=""
                android:textSize="11dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineHeight="18dp"
                android:maxLines="2"
                android:text=""
                android:textColor="@color/widget_on_surface"
                android:textSize="13.5dp" />

            <TextView
                android:id="@+id/place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="11dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
