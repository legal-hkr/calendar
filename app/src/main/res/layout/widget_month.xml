<?xml version="1.0" encoding="utf-8"?>
<!-- The Month widget (SPEC §17.5): one frame (the surface, radius 24) – the one widget with a ground under everything, as numbers and dots can't be read on a wallpaper – with the month's badge on its corner as Next event's. Inside: the weekdays' row, then six weeks sharing the height; their days are added in code (widget_month_cell). 2 dp at the end and 4 at the foot leave room for the shadow, which falls downward. Sizes are in dp, text too. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipToOutline="true"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="8dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="2dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/widget_frame"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingTop="28dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal">

        <TextView
            android:id="@+id/weekday0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11dp" />
        <TextView
            android:id="@+id/weekday1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11dp" />
        <TextView
            android:id="@+id/weekday2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11dp" />
        <TextView
            android:id="@+id/weekday3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11dp" />
        <TextView
            android:id="@+id/weekday4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11dp" />
        <TextView
            android:id="@+id/weekday5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11dp" />
        <TextView
            android:id="@+id/weekday6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="11dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/week0"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/week1"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/week2"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/week3"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/week4"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/week5"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal" />
    </LinearLayout>

    <include layout="@layout/widget_badge" />
</FrameLayout>
