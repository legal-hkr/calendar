<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Events live in the system's calendar provider; the app reads and writes it and never talks to a server. No INTERNET. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- Reminders of events are notifications the app posts itself; asked for in the first-run pages. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- A reminder appears at its exact time, also with the phone asleep. Granted to calendar apps at
         install; nothing the user has to switch on. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- The next reminder is set again after a restart of the phone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- To name the app an account belongs to on the Calendars page ("DAVx⁵"): the apps that provide accounts -->
    <queries>
        <intent>
            <action android:name="android.accounts.AccountAuthenticator" />
        </intent>
        <!-- Whether a maps app can take an event's place (the Directions icon) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".CalendarApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Calendar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            tools:ignore="DiscouragedApi,LockedOrientationActivity">
            <!-- Portrait only for now, as the rest of the family; no landscape (dropped in Calculator after a trial) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A calendar file opened from another app – a ticket in a mail, a download (SPEC §13.1). Read once, nothing is kept of it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="application/ics" />
                <data android:mimeType="text/x-vcalendar" />
            </intent-filter>
            <!-- The same file shared to the app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="application/ics" />
                <data android:mimeType="text/x-vcalendar" />
            </intent-filter>
        </activity>

        <!-- The alarm set for the next reminder and the reminder notifications' buttons; reached only by the app's own pending intents. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- After a restart, an update of the app, or a change of the clock, the time zone or the language:
             the reminders are worked out anew. -->
        <receiver
            android:name=".reminders.SystemReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.LOCALE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Run by the system when the calendar's content changes while the app is closed (a sync by the
             account's app), so the reminders follow. Only the system can bind it. -->
        <service
            android:name=".reminders.ChangeJob"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Home-screen widgets (SPEC §17). Exported as the system requires: the launcher's widget service sends their updates. -->
        <receiver
            android:name=".widget.AgendaWidget"
            android:exported="true"
            android:label="@string/widget_agenda_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda" />
        </receiver>
        <receiver
            android:name=".widget.NextEventWidget"
            android:exported="true"
            android:label="@string/widget_next_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_next" />
        </receiver>
        <receiver
            android:name=".widget.MonthWidget"
            android:exported="true"
            android:label="@string/widget_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_month" />
        </receiver>
        <receiver
            android:name=".widget.UpcomingWidget"
            android:exported="true"
            android:label="@string/widget_upcoming_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming" />
        </receiver>

        <receiver
            android:name=".widget.UpcomingBareWidget"
            android:exported="true"
            android:label="@string/widget_upcoming_bare_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_upcoming_bare" />
        </receiver>
        <receiver
            android:name=".widget.AgendaBareWidget"
            android:exported="true"
            android:label="@string/widget_agenda_bare_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_agenda_bare" />
        </receiver>

        <!-- Hands the one event being shared as a file to the app the user picks; nothing else is reachable -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
