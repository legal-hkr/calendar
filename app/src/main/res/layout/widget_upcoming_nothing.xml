<?xml version="1.0" encoding="utf-8"?>
<!-- The Upcoming events widget with nothing coming (SPEC §17.9): one pill as wide as its content, the symbol (16 dp) and the words in on-surface-variant, 500. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SpUsage,ContentDescription"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_floating_frame"
    android:clipToOutline="true"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/first"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="center_vertical"
        android:layout_margin="2dp"
        android:background="@drawable/widget_pill"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_event_available"
            android:tint="@color/widget_on_surface_variant"
            tools:ignore="UseAppTint" />

        <TextView
            android:id="@+id/first_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_on_surface_variant"
            android:textSize="13.5dp" />
    </LinearLayout>
</FrameLayout>
