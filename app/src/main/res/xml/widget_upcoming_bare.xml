<?xml version="1.0" encoding="utf-8"?>
<!-- Upcoming events without a background (SPEC §17.7): four by one cells, resizable in width only. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_upcoming_bare_description"
    android:initialLayout="@layout/widget_upcoming_bare_nothing"
    android:minWidth="250dp"
    android:minHeight="50dp"
    android:minResizeWidth="200dp"
    android:minResizeHeight="50dp"
    android:previewLayout="@layout/widget_upcoming_bare_preview"
    android:resizeMode="horizontal"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
